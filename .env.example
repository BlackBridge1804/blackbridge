# Copy this file to .env and fill in real values before running.

# Database (defaults to local SQLite for the demo; swap for Postgres/Supabase in production)
DATABASE_URL=sqlite:///./credit_repair.db

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Anthropic API (used for report parsing assistance and letter-prose polishing only ---
# violation DETECTION always stays in the deterministic rules engine, never the model)
ANTHROPIC_API_KEY=

# Stripe (billing / paywall)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PER_REPORT=

# Platform admin bootstrap (used once, to create the first platform-admin account)
PLATFORM_ADMIN_EMAIL=you@example.com
PLATFORM_ADMIN_PASSWORD=change-me
